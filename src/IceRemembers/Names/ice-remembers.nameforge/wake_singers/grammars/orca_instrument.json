{
  "id": "orca_instrument",
  "start": "name",
  "capitalization": "titleWords",
  "rules": {
    "name": [
      [
        "when:producer_kind=generator",
        "context:primary_entity_name~poss",
        "slot:orca_instrument_nouns"
      ],
      [
        "when:producer_kind=generator",
        "context:secondary_entity_name~poss",
        "slot:orca_instrument_nouns"
      ],
      [
        "slot:orca_prey_glyph~cap^slot:orca_deed_root",
        "drum"
      ],
      [
        "slot:orca_territory_glyph~cap^slot:orca_prey_glyph",
        "horn"
      ],
      [
        "slot:orca_deed_root~cap^slot:orca_role_glyph^slot:orca_instrument_nouns"
      ]
    ]
  }
}
