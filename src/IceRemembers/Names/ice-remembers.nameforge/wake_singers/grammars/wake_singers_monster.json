{
  "id": "wake_singers_monster",
  "description": "Ice Remembers monster names",
  "start": "name",
  "capitalization": "titleWords",
  "rules": {
    "name": [
      [
        "when:producer_kind=generator",
        "context:primary_entity_name~poss",
        "slot:wake_singers_monster_nouns"
      ],
      [
        "when:producer_kind=generator",
        "domain:orca_domain_short",
        "context:primary_entity_name~poss",
        "slot:wake_singers_monster_nouns"
      ],
      [
        "slot:orca_territory_glyph^-^slot:wake_singers_monster_nouns"
      ],
      [
        "domain:orca_domain_short",
        "slot:orca_territory_glyph^-^slot:wake_singers_monster_nouns"
      ],
      [
        "slot:orca_prey_glyph^-^slot:orca_deed_root^-^slot:wake_singers_monster_nouns"
      ],
      [
        "domain:orca_domain_short",
        "slot:orca_prey_glyph^-^slot:orca_deed_root^-^slot:wake_singers_monster_nouns"
      ],
      [
        "slot:orca_deed_root^-^slot:wake_singers_monster_nouns"
      ],
      [
        "domain:orca_domain_short",
        "slot:orca_deed_root^-^slot:wake_singers_monster_nouns"
      ]
    ]
  }
}
