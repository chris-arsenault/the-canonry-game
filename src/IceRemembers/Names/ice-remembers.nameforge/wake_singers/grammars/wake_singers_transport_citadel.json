{
  "id": "wake_singers_transport_citadel",
  "description": "Wake-Singer names for citadel transports",
  "start": "name",
  "capitalization": "titleWords",
  "rules": {
    "name": [
      [
        "when:producer=trade_conferences_raise_citadels",
        "context:primary_entity_name~poss",
        "citadel"
      ],
      [
        "when:producer=trade_conferences_raise_citadels",
        "domain:wake_singers_domain_short",
        "context:primary_entity_name~poss",
        "citadel"
      ],
      [
        "when:producer_kind=generator",
        "context:primary_entity_name~poss",
        "slot:wake_singers_transport_citadel_nouns"
      ],
      [
        "when:producer_kind=generator",
        "domain:wake_singers_domain_short",
        "context:primary_entity_name~poss",
        "slot:wake_singers_transport_citadel_nouns"
      ],
      [
        "slot:orca_territory_glyph^slot:wake_singers_transport_citadel_nouns"
      ],
      [
        "domain:wake_singers_domain_short",
        "slot:orca_territory_glyph^slot:wake_singers_transport_citadel_nouns"
      ],
      [
        "slot:orca_deed_root^slot:orca_role_glyph^slot:wake_singers_transport_citadel_nouns"
      ],
      [
        "domain:wake_singers_domain_short",
        "slot:orca_deed_root^slot:orca_role_glyph^slot:wake_singers_transport_citadel_nouns"
      ]
    ]
  }
}
