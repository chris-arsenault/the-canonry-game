      [
        "domain:aurora_domain~cap",
        "context:region^'",
        "slot:aurora_law_terms",
        "(^slot:aurora_place_echoes^)"
      ],
      [
        "slot:aurora_law_terms",
        "(^context:region^-sworn)"
      ],
      [
        "domain:aurora_domain~cap",
        "slot:aurora_law_terms",
        "(^context:region^-sworn)"
      ]
    ]
  }
}
