      ],
      [
        "slot:aurora_gathering_type~cap",
        "slot:aurora_social_suffix"
      ],
      [
        "domain:aurora_domain~cap",
        "slot:aurora_gathering_type~cap",
        "slot:aurora_social_suffix"
      ]
    ]
  }
}
