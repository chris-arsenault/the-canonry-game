{
  "id": "aurora_hero_legendary",
  "start": "name",
  "rules": {
    "name": [
      [
        "when:producer=stolen_artifacts_draw_hunters",
        "when:parent_producer=monster_steals_artifact",
        "domain:aurora_domain~cap",
        "context:trigger_relationship_target_entity_name~poss",
        "Warden"
      ],
      [
        "when:producer=orca_route_wars_get_names",
        "when:parent_producer=orca_raids_trade_route",
        "domain:aurora_domain~cap",
        "context:trigger_relationship_target_entity_name~poss",
        "Route Warden"
      ],
      [
        "domain:aurora_domain~cap",
        "(^slot:aurora_ice_echoes^,",
        "echo:",
        "slot:aurora_hero_deeds^)",
        "slot:aurora_hero_epithets"
      ],
      [
        "slot:aurora_gen_titles",
        "domain:aurora_domain~cap",
        "(^slot:aurora_ice_echoes^)",
        "the",
        "slot:aurora_hero_deeds"
      ]
    ]
  }
}
