{
  "id": "aurora_monster_beast",
  "description": "Aurora names for embodied beast monsters",
  "start": "name",
  "capitalization": "titleWords",
  "rules": {
    "name": [
      [
        "when:producer_kind=generator",
        "context:primary_entity_name~poss",
        "Beast",
        "(^slot:aurora_place_echoes_short^)"
      ],
      [
        "when:producer_kind=generator",
        "domain:aurora_domain~cap",
        "context:primary_entity_name~poss",
        "Beast",
        "(^slot:aurora_place_echoes_short^)"
      ],
      [
        "slot:aurora_nature~cap",
        "Beast",
        "(^slot:aurora_place_echoes_short^)"
      ],
      [
        "domain:aurora_domain~cap",
        "slot:aurora_nature~cap",
        "Beast",
        "(^slot:aurora_place_echoes_short^)"
      ],
      [
        "slot:aurora_gen_nouns~cap^-Maw",
        "(^slot:aurora_place_echoes_short^)"
      ],
      [
        "domain:aurora_domain~cap",
        "slot:aurora_gen_nouns~cap^-Maw",
        "(^slot:aurora_place_echoes_short^)"
      ]
    ]
  }
}
