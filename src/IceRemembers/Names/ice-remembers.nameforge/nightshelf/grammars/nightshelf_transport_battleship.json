{
  "id": "nightshelf_transport_battleship",
  "description": "Nightshelf names for armed transports",
  "start": "name",
  "capitalization": "titleWords",
  "rules": {
    "name": [
      [
        "when:producer=orca_route_wars_get_names",
        "when:parent_producer=orca_raids_trade_route",
        "Ward Against",
        "context:trigger_relationship_source_entity_name"
      ],
      [
        "when:producer=orca_route_wars_get_names",
        "when:parent_producer=orca_raids_trade_route",
        "context:trigger_relationship_target_entity_name~poss",
        "Escort"
      ],
      [
        "☽'^slot:nightshelf_darkness_source~lower^'",
        "Watch-Keel"
      ],
      [
        "slot:nightshelf_rule_anchors~cap^∴hush-guard"
      ],
      [
        "slot:nightshelf_shadow_gen~cap^∴black-bastion"
      ],
      [
        "slot:nightshelf_shadow_gen~cap",
        "Watch-Keel^☽"
      ]
    ]
  }
}
