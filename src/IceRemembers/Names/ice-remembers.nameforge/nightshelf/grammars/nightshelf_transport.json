{
  "id": "nightshelf_transport",
  "description": "Ice Remembers transport names",
  "start": "name",
  "capitalization": "titleWords",
  "rules": {
    "name": [
      [
        "when:producer=trade_routes_convene_negotiation",
        "context:trigger_relationship_source_entity_name",
        "to",
        "context:trigger_relationship_target_entity_name",
        "Vessel"
      ],
      [
        "when:producer=trade_routes_convene_negotiation",
        "domain:nightshelf_domain~cap^~",
        "context:trigger_relationship_source_entity_name",
        "to",
        "context:trigger_relationship_target_entity_name",
        "Vessel"
      ],
      [
        "when:producer=monster_slayings_become_festivals",
        "when:parent_producer=penguin_slays_monster",
        "context:trigger_relationship_source_entity_name~poss",
        "Cleansing",
        "Vessel"
      ],
      [
        "when:producer=monster_slayings_become_festivals",
        "when:parent_producer=penguin_slays_monster",
        "domain:nightshelf_domain~cap^~",
        "context:trigger_relationship_source_entity_name~poss",
        "Cleansing",
        "Vessel"
      ],
      [
        "when:producer=orca_route_wars_get_names",
        "when:parent_producer=orca_raids_trade_route",
        "context:trigger_relationship_source_entity_name~poss",
        "War",
        "Vessel"
      ],
      [
        "when:producer=orca_route_wars_get_names",
        "when:parent_producer=orca_raids_trade_route",
        "domain:nightshelf_domain~cap^~",
        "context:trigger_relationship_source_entity_name~poss",
        "War",
        "Vessel"
      ],
      [
        "when:producer=orca_route_wars_get_names",
        "when:parent_producer=orca_raids_trade_route",
        "Ward",
        "Against",
        "context:trigger_relationship_source_entity_name"
      ],
      [
        "when:producer=orca_route_wars_get_names",
        "when:parent_producer=orca_raids_trade_route",
        "domain:nightshelf_domain~cap^~",
        "Ward",
        "Against",
        "context:trigger_relationship_source_entity_name"
      ],
      [
        "when:producer=war_occurrences_launch_scouts",
        "context:primary_entity_name~poss",
        "Scout"
      ],
      [
        "when:producer=war_occurrences_launch_scouts",
        "domain:nightshelf_domain~cap^~",
        "context:primary_entity_name~poss",
        "Scout"
      ],
      [
        "when:producer=trade_conferences_raise_citadels",
        "context:primary_entity_name~poss",
        "Citadel"
      ],
      [
        "when:producer=trade_conferences_raise_citadels",
        "domain:nightshelf_domain~cap^~",
        "context:primary_entity_name~poss",
        "Citadel"
      ],
      [
        "when:producer_kind=generator",
        "context:primary_entity_name~poss",
        "slot:nightshelf_transport_nouns~cap"
      ],
      [
        "when:producer_kind=generator",
        "domain:nightshelf_domain~cap^~",
        "context:primary_entity_name~poss",
        "slot:nightshelf_transport_nouns~cap"
      ],
      [
        "slot:nightshelf_shadow_gen~cap",
        "slot:nightshelf_transport_nouns~cap"
      ],
      [
        "domain:nightshelf_domain~cap^~",
        "slot:nightshelf_shadow_gen~cap",
        "slot:nightshelf_transport_nouns~cap"
      ],
      [
        "☽'^domain:nightshelf_domain~lower^'",
        "slot:nightshelf_transport_nouns~cap"
      ],
      [
        "slot:nightshelf_whisper_roots~cap^-^slot:nightshelf_transport_nouns"
      ],
      [
        "domain:nightshelf_domain~cap^~",
        "slot:nightshelf_whisper_roots~cap^-^slot:nightshelf_transport_nouns"
      ]
    ]
  }
}
