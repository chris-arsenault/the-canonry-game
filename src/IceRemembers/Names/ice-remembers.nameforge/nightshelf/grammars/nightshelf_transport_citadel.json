{
  "id": "nightshelf_transport_citadel",
  "description": "Nightshelf names for mobile citadels",
  "start": "name",
  "capitalization": "titleWords",
  "rules": {
    "name": [
      [
        "when:producer=trade_conferences_raise_citadels",
        "context:primary_entity_name~poss",
        "Tow-Citadel"
      ],
      [
        "☽'^slot:nightshelf_latin_roots",
        "Tow-Vault"
      ],
      [
        "slot:nightshelf_rule_anchors~cap^∴moving-vault"
      ],
      [
        "slot:nightshelf_darkness_source~cap^∴citadel"
      ],
      [
        "slot:nightshelf_shadow_gen~cap",
        "Citadel^☽"
      ]
    ]
  }
}
