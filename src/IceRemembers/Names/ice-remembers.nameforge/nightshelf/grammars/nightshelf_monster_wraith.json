{
  "id": "nightshelf_monster_wraith",
  "description": "Nightshelf names for wraith monsters",
  "start": "name",
  "capitalization": "titleWords",
  "rules": {
    "name": [
      [
        "when:producer_kind=generator",
        "context:primary_entity_name~poss",
        "Wraith"
      ],
      [
        "slot:nightshelf_remnant~cap^∴wraith"
      ],
      [
        "☽'^slot:nightshelf_latin_roots",
        "Name-Wraith"
      ],
      [
        "slot:nightshelf_shadow_gen~cap^∴unspoken"
      ],
      [
        "slot:nightshelf_remnant~cap",
        "Wraith^~"
      ]
    ]
  }
}
