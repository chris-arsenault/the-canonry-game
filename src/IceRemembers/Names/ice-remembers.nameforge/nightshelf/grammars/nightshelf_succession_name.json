{
  "id": "nightshelf_succession_name",
  "start": "name",
  "capitalization": "titleWords",
  "rules": {
    "name": [
      [
        "when:producer_kind=generator",
        "context:primary_entity_name~poss",
        "Succession"
      ],
      [
        "when:producer_kind=generator",
        "context:primary_entity_name",
        "Successio☽"
      ],
      [
        "slot:nightshelf_succession_prefix~cap^∴^slot:nightshelf_war_names"
      ],
      [
        "☽'^slot:nightshelf_succession_prefix",
        "slot:nightshelf_war_names~cap"
      ],
      [
        "slot:nightshelf_succession_prefix~cap",
        "slot:nightshelf_war_names~cap^☽"
      ]
    ]
  }
}
