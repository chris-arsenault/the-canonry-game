{
  "id": "nightshelf_artifact",
  "start": "name",
  "capitalization": "titleWords",
  "rules": {
    "name": [
      [
        "when:producer_kind=generator",
        "context:primary_entity_name~poss",
        "slot:nightshelf_artifact_nouns~title"
      ],
      [
        "slot:nightshelf_artifact_modifiers~title",
        "slot:nightshelf_artifact_nouns~title^☽"
      ],
      [
        "☽'^domain:nightshelf_domain~lower^'",
        "slot:nightshelf_artifact_nouns~cap"
      ],
      [
        "slot:nightshelf_artifact_modifiers~title^∴^slot:nightshelf_artifact_nouns"
      ]
    ]
  }
}
