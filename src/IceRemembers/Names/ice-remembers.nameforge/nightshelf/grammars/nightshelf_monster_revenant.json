{
  "id": "nightshelf_monster_revenant",
  "description": "Nightshelf names for revenant monsters",
  "start": "name",
  "capitalization": "titleWords",
  "rules": {
    "reference_name": [
      [
        "domain:monster_tongue~cap"
      ]
    ],
    "name": [
      [
        "when:producer_kind=generator",
        "context:reference_name^,",
        "context:primary_entity_name~poss",
        "Revenant"
      ],
      [
        "context:reference_name^,",
        "slot:nightshelf_remnant~cap^∴returned"
      ],
      [
        "context:reference_name^,",
        "☽'^slot:nightshelf_latin_roots",
        "Debt-Revenant"
      ],
      [
        "context:reference_name^,",
        "slot:nightshelf_forbidden_truth~cap^∴after-echo"
      ],
      [
        "context:reference_name^,",
        "slot:nightshelf_remnant~cap",
        "Revenant^~"
      ]
    ]
  },
  "generatedContext": {
    "reference_name": "reference_name"
  }
}
