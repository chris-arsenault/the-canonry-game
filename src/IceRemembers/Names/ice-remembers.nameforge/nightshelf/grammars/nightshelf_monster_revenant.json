{
  "id": "nightshelf_monster_revenant",
  "description": "Nightshelf names for revenant monsters",
  "start": "name",
  "capitalization": "titleWords",
  "rules": {
    "name": [
      [
        "when:producer_kind=generator",
        "context:primary_entity_name~poss",
        "Revenant^~"
      ],
      [
        "when:producer_kind=generator",
        "domain:nightshelf_domain~cap^~",
        "context:primary_entity_name~poss",
        "Revenant^~"
      ],
      [
        "slot:nightshelf_remnant^∴returned"
      ],
      [
        "domain:nightshelf_domain~cap^~",
        "slot:nightshelf_remnant^∴returned"
      ],
      [
        "☽'^slot:nightshelf_latin_roots",
        "debt-revenant^~"
      ],
      [
        "domain:nightshelf_domain~cap^~",
        "☽'^slot:nightshelf_latin_roots",
        "debt-revenant^~"
      ],
      [
        "slot:nightshelf_forbidden_truth^∴after-name∴"
      ],
      [
        "domain:nightshelf_domain~cap^~",
        "slot:nightshelf_forbidden_truth^∴after-name∴"
      ]
    ]
  }
}
