{
  "id": "nightshelf_instrument",
  "start": "name",
  "capitalization": "titleWords",
  "rules": {
    "name": [
      [
        "☽'^domain:nightshelf_domain~lower^'",
        "slot:nightshelf_instrument_nouns~cap"
      ],
      [
        "when:producer_kind=generator",
        "context:primary_entity_name~poss",
        "slot:nightshelf_instrument_nouns~title"
      ],
      [
        "when:producer_kind=generator",
        "context:selected_name~poss",
        "slot:nightshelf_instrument_nouns~title"
      ],
      [
        "slot:nightshelf_shadow_gen~ed~cap",
        "slot:nightshelf_instrument_nouns~title^☽"
      ]
    ]
  }
}
