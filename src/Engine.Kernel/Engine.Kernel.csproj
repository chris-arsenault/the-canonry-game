<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <KernelForbiddenStringPattern>&quot;|(?&lt;![A-Za-z0-9_])string(?![A-Za-z0-9_])|System\.String</KernelForbiddenStringPattern>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine.Constants\Engine.Constants.csproj" />
    <ProjectReference Include="..\Engine.Eventing\Engine.Eventing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Engine.Kernel.Driver" />
    <InternalsVisibleTo Include="Engine.Kernel.Schema" />
    <InternalsVisibleTo Include="Engine.Host" />
    <InternalsVisibleTo Include="Engine.Eventing.Tests" />
    <InternalsVisibleTo Include="Engine.Host.Tests" />
    <InternalsVisibleTo Include="Engine.Kernel.Driver.Tests" />
    <InternalsVisibleTo Include="Engine.Kernel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/BannedSymbols.txt" />
  </ItemGroup>

  <Target Name="ValidateKernelBoundaryReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <ForbiddenKernelProjectReference Include="@(ProjectReference)"
        Condition="'%(ProjectReference.Filename)' != 'Engine.Constants' and '%(ProjectReference.Filename)' != 'Engine.Eventing'" />
      <ForbiddenKernelPackageReference Include="@(PackageReference)"
        Condition="'%(PackageReference.Identity)' != 'Microsoft.CodeAnalysis.BannedApiAnalyzers'" />
    </ItemGroup>

    <Error
      Condition="'@(ForbiddenKernelProjectReference)' != ''"
      Text="Engine.Kernel may only reference Engine.Constants and Engine.Eventing. Forbidden project references: @(ForbiddenKernelProjectReference)" />
    <Error
      Condition="'@(ForbiddenKernelPackageReference)' != ''"
      Text="Engine.Kernel may not add runtime package dependencies. Forbidden package references: @(ForbiddenKernelPackageReference)" />
  </Target>

  <Target Name="ValidateKernelSourceText" BeforeTargets="CoreCompile">
    <ItemGroup>
      <KernelCompile Include="@(Compile)"
        Condition="$([System.String]::Copy('%(Compile.FullPath)').StartsWith('$(MSBuildProjectDirectory)'))" />
    </ItemGroup>

    <Error
      Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(KernelCompile.FullPath)')), '$(KernelForbiddenStringPattern)'))"
      Text="Engine.Kernel source file '%(KernelCompile.Identity)' contains forbidden string syntax. Kernel code must use primitive IDs and may not contain string literals, string types, or System.String." />
  </Target>
</Project>
