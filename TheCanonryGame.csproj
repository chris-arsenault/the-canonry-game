<Project Sdk="Godot.NET.Sdk/4.6.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>TheCanonryGame</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- Scene scripts must compile into the main Godot assembly for resource path lookup at runtime. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);src/Engine/**;src/Engine.Constants/**;src/Engine.Domain/**;src/Engine.Eventing/**;src/Engine.Eventing.Schema/**;src/Engine.Host/**;src/Engine.Kernel/**;src/Engine.Kernel.Driver/**;src/Engine.Kernel.Schema/**;src/Engine.Observability/**;src/Engine.Observability.Export/**;src/Engine.Projection/**;tests/**;tools/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/TheCanonryGame.App/**/*.cs" />
    <Compile
      Include="src/TheCanonryGame.UI/**/*.cs"
      Exclude="src/TheCanonryGame.UI/.godot/**/*.cs;src/TheCanonryGame.UI/bin/**/*.cs;src/TheCanonryGame.UI/obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src/Engine.Constants/Engine.Constants.csproj" />
    <ProjectReference Include="src/Engine.Projection/Engine.Projection.csproj" />
    <ProjectReference Include="src/TheCanonryGame.Game/TheCanonryGame.Game.csproj" />
    <ProjectReference Include="src/TheCanonryGame.UI.Core/TheCanonryGame.UI.Core.csproj" />
  </ItemGroup>
</Project>
